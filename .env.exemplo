# Modelo de configuração LOCAL. Copie para .env (que NÃO vai para o git) e troque os valores:
#   cp .env.exemplo .env
# Lido pelo docker-compose (banco) e pelo perfil "local" do Spring (aplicação).

# Senha do PostgreSQL local. Qualquer valor; banco e aplicação leem a mesma variável.
DB_PASSWORD=troque-esta-senha

# Segredo do JWT (HS256): no mínimo 32 bytes. Gere um aleatório, por exemplo:
#   openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-bytes

# Primeiro ADMINISTRADOR: criado ao iniciar a aplicação se ainda não existir nenhum.
# A senha precisa ter pelo menos 8 caracteres, com letras e números (senão a aplicação não sobe).
ADMIN_EMAIL=admin@senac.br
ADMIN_SENHA=troque-esta-senha-1
